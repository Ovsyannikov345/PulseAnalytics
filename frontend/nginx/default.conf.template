# Rendered into /etc/nginx/conf.d/default.conf by the image's entrypoint (envsubst).
# ${API_GATEWAY_URL} and ${NGINX_RESOLVER} come from the environment; defaults are set in the Dockerfile.
# The browser talks to this server only: it serves the app and proxies the API, so no CORS is needed.

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;

    server_tokens off;
    # Relative redirects, so they don't point at the container port (8080) instead of the published one.
    absolute_redirect off;

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # The gateway's address is resolved at request time (Docker's embedded DNS by default), so nginx starts
    # while the gateway is down and follows a recreated gateway container to its new IP.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
    set $api_gateway ${API_GATEWAY_URL};

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    include /etc/nginx/security-headers.conf;

    location = /health {
        access_log off;
        default_type text/plain;
        return 200 "OK\n";
    }

    # GraphQL over POST only: the gateway answers GET /graphql with the Nitro IDE, which stays on its own port.
    location = /graphql {
        limit_except POST {
            deny all;
        }
        proxy_pass $api_gateway;
    }

    # REST (CSV export). Not buffered, so a large export streams through instead of filling a temp file first.
    location /api/ {
        proxy_buffering off;
        proxy_pass $api_gateway;
    }

    # Hashed build output: cached for a year. A missing file is a 404, never index.html.
    location /assets/ {
        try_files $uri =404;
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    # Revalidated on every load, so a new deployment is picked up at once.
    location = /index.html {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }

    # Client-side routes (/analytics, /readings, ...) get the app.
    location / {
        try_files $uri /index.html;
    }
}
