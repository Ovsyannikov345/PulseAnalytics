WEAKAPP_API_KEY=supersecret

RABBITMQ_USER=user
RABBITMQ_PASSWORD=password

POSTGRES_USER=user
POSTGRES_PASSWORD=password
# Database created on first start (optional, defaults to pulse_analytics).
# POSTGRES_DB=pulse_analytics

SEQ_ADMIN_PASSWORD=password
# Seq API key for log ingestion (optional; create it in the Seq UI).
# SEQ_API_KEY=

# Grafana login
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=password

# Ingestor image tag on Docker Hub (optional, defaults to latest; pin e.g. sha-cdf4c5d).
# DATA_INGESTOR_TAG=latest
# Processor image tag on Docker Hub (optional, defaults to latest).
# DATA_PROCESSOR_TAG=latest
# API gateway image tag on Docker Hub (optional, defaults to latest).
# API_GATEWAY_TAG=latest

# Browser origin of the frontend, allowed by CORS (optional, defaults to the Vite dev server).
# scheme://host[:port] only: no path or trailing slash (the gateway refuses to start otherwise).
# FRONTEND_ORIGIN=http://localhost:5173

# Host ports (optional, defaults shown).
# SEQ_PORT=5341
# WEAKAPP_PORT=5000
# RABBITMQ_PORT=5672
# RABBITMQ_MANAGEMENT_PORT=15672
# POSTGRES_PORT=5432
# DATA_INGESTOR_PORT=5101
# DATA_PROCESSOR_PORT=5102
# API_GATEWAY_PORT=5103
# OTEL_COLLECTOR_GRPC_PORT=4317
# OTEL_COLLECTOR_HTTP_PORT=4318
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000
