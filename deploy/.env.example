WEAKAPP_API_KEY=supersecret

RABBITMQ_USER=user
RABBITMQ_PASSWORD=password

SEQ_ADMIN_PASSWORD=password
# Seq API key for log ingestion (optional; create it in the Seq UI).
# SEQ_API_KEY=

# Grafana login
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=password

# Ingestor image tag on Docker Hub (optional, defaults to latest; pin e.g. sha-cdf4c5d).
# DATA_INGESTOR_TAG=latest

# Host ports (optional, defaults shown).
# SEQ_PORT=5341
# WEAKAPP_PORT=5000
# RABBITMQ_PORT=5672
# RABBITMQ_MANAGEMENT_PORT=15672
# DATA_INGESTOR_PORT=5101
# OTEL_COLLECTOR_GRPC_PORT=4317
# OTEL_COLLECTOR_HTTP_PORT=4318
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000
