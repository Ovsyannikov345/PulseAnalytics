# Environment for deploy/docker-compose.yml.
# Copy this file to deploy/.env (git-ignored). The defaults below work for a local run as they are.
#
# Credentials marked "first start only" are written into a Docker volume when the container
# starts for the first time. Changing them later has no effect until the volume is removed
# with `docker compose -f deploy/docker-compose.yml down -v` (this deletes all stored data).

# Key the WeakApp container expects in the X-Api-Key header. WeakApp ships with this key
# built in and it cannot be changed there, so keep the value as is.
WEAKAPP_API_KEY=supersecret

# RabbitMQ user for the broker and every service (first start only).
RABBITMQ_USER=user
RABBITMQ_PASSWORD=password

# PostgreSQL superuser used by the data processor and the API gateway (first start only).
POSTGRES_USER=user
POSTGRES_PASSWORD=password
# Database created on first start (optional, defaults to pulse_analytics).
# POSTGRES_DB=pulse_analytics

# Password of the Seq "admin" user (first start only).
SEQ_ADMIN_PASSWORD=password
# Seq API key for log ingestion (optional; Seq accepts logs without a key by default).
# Create the key in the Seq UI, then set it here and restart the services.
# SEQ_API_KEY=

# Grafana login (first start only).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=password

# Service image tags on Docker Hub (optional, default latest).
# CI pushes `latest` and `sha-<short commit>` for every merge to main; pin a commit with e.g. sha-1c512fb.
# Set a tag to `local` to run an image built on this machine (see "Run a locally built image" in README.md).
# DATA_INGESTOR_TAG=latest
# DATA_PROCESSOR_TAG=latest
# API_GATEWAY_TAG=latest
# NOTIFICATION_SERVICE_TAG=latest
# FRONTEND_TAG=latest

# Host ports (optional, defaults shown). Change one if it is already taken on your machine.
# SEQ_PORT=5341
# WEAKAPP_PORT=5000
# RABBITMQ_PORT=5672
# RABBITMQ_MANAGEMENT_PORT=15672
# POSTGRES_PORT=5432
# FRONTEND_PORT=5100
# DATA_INGESTOR_PORT=5101
# DATA_PROCESSOR_PORT=5102
# API_GATEWAY_PORT=5103
# NOTIFICATION_SERVICE_PORT=5104
# OTEL_COLLECTOR_GRPC_PORT=4317
# OTEL_COLLECTOR_HTTP_PORT=4318
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000
