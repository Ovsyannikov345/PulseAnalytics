{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj} {CorrelationId}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "data-processor"
    }
  },
  "AllowedHosts": "*",
  "RabbitMq": {
    "Host": "",
    "Port": 5672,
    "VirtualHost": "/",
    "UserName": "",
    "Password": "",
    "ClientProvidedName": "pulse-analytics.data-processor"
  },
  "Database": {
    "ConnectionString": ""
  },
  "Seq": {
    "ServerUrl": "",
    "ApiKey": ""
  }
}
