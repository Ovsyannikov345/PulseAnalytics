{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "Polly": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "data-ingestor"
    },
    "Seq": {
      "ServerUrl": "",
      "ApiKey": ""
    }
  },
  "AllowedHosts": "*",
  "WeakApp": {
    "BaseUrl": "",
    "ApiKey": "",
    "Resilience": {
      "TotalTimeoutInSeconds": 20,
      "AttemptTimeoutInSeconds": 5,
      "MaxRetryAttempts": 2,
      "RetryBaseDelayInSeconds": 1
    }
  },
  "RabbitMq": {
    "Host": "",
    "Port": 5672,
    "VirtualHost": "/",
    "UserName": "",
    "Password": "",
    "PublishTimeoutInSeconds": 5
  },
  "MeterPollingWorker": {
    "PollingPeriodInSeconds": 15,
    "StartupDelayInSeconds": 5
  }
}
