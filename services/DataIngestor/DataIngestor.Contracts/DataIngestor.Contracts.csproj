<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<IsPackable>true</IsPackable>
		<PackageId>PulseAnalytics.DataIngestor.Contracts</PackageId>
		<Description>Message contracts of the events published by the Pulse Analytics Data Ingestor.</Description>
		<PackageTags>pulse-analytics;messaging;contracts;rabbitmq</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/Ovsyannikov345/PulseAnalytics</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<MinVerTagPrefix>contracts-v</MinVerTagPrefix>
		<MinVerDefaultPreReleaseIdentifiers>preview.0</MinVerDefaultPreReleaseIdentifiers>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="MinVer" Version="6.0.0" PrivateAssets="all" />
	</ItemGroup>

</Project>
